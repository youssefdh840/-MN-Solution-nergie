rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Secure administrator verification
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email in ['youssefdh840@gmail.com', 'mohamednefzaoui09@gmail.com'] && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation helper for creating quote requests
    function isValidQuoteRequest(data) {
      return data.keys().hasAll([
        'reference', 'customerName', 'phone', 'service',
        'projectType', 'description', 'city', 'preferredContact',
        'status', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'reference', 'customerName', 'phone', 'email', 'service',
        'projectType', 'description', 'city', 'address', 'preferredContact',
        'status', 'createdAt', 'updatedAt', 'notes'
      ]) &&
      data.reference is string && data.reference.size() <= 32 &&
      data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
      data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 30 &&
      (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
      data.service in ['chauffage', 'climatisation', 'plomberie', 'multiple'] &&
      data.projectType in ['installation', 'depannage', 'entretien', 'renovation', 'autre'] &&
      data.description is string && data.description.size() >= 5 && data.description.size() <= 3000 &&
      data.city is string && data.city.size() <= 100 &&
      (!('address' in data) || (data.address is string && data.address.size() <= 200)) &&
      data.preferredContact in ['telephone', 'sms', 'email'] &&
      data.status in ['nouveau', 'contacte', 'visite_programmee', 'devis_envoye', 'termine', 'annule', 'archive'] &&
      data.createdAt is string && data.createdAt.size() <= 40 &&
      data.updatedAt is string && data.updatedAt.size() <= 40 &&
      (!('notes' in data) || (data.notes is list && data.notes.size() <= 100));
    }

    // Collection: quoteRequests
    match /quoteRequests/{requestId} {
      // Public visitors can submit a validated request with status 'nouveau'
      allow create: if isValidId(requestId) &&
                       isValidQuoteRequest(incoming()) &&
                       incoming().status == 'nouveau';

      // Only authorized administrators can read, list, update or delete customer requests
      allow get, list: if isAdmin();

      allow update: if isValidId(requestId) &&
                       isAdmin() &&
                       isValidQuoteRequest(incoming()) &&
                       incoming().reference == existing().reference &&
                       incoming().createdAt == existing().createdAt;

      allow delete: if isValidId(requestId) && isAdmin();
    }

    // Collection: admins
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }
  }
}
